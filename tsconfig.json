{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "scher": ["../scher/src/index.ts"],
      "scher/*": ["../scher/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "muslin/**/*.ts", "viewer/**/*.ts", "vitest.config.ts"]
}
